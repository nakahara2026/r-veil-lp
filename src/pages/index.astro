---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Placeholder from '../components/Placeholder.astro';

const bagPhotos = Array.from({ length: 10 });
const coatPhotos = Array.from({ length: 9 });
const pad2 = (n) => String(n).padStart(2, '0');
---

<BaseLayout>
	<main>
		<!-- Section 01: ヒーロー（動画） -->
		<section class="hero">
			<div class="hero__media">
				<span class="hero__media-label">ヒーロー動画: 森・霧の航空/地上ショット（mp4, ループ, 尺約2:10）</span>
			</div>
			<div class="hero__controls">
				<button class="hero__play" id="hero-play" type="button" aria-label="再生 / 一時停止">▶</button>
				<div class="hero__seek"><span class="hero__seek-fill"></span></div>
				<span class="hero__time">00:01 / 02:10</span>
				<button class="hero__icon" type="button" aria-label="音量">♪</button>
				<button class="hero__icon" type="button" aria-label="フルスクリーン">⤢</button>
			</div>
		</section>

		<!-- Section 02: ニュースバー -->
		<section class="news-bar">
			<p class="news-bar__text">
				<span class="news-bar__label">NEWS</span>
				7月15日から予約開始！先着購入特典も。<a href="#bag" class="news-bar__link">詳細はこちら &gt;&gt;</a>
			</p>
		</section>

		<!-- Section 03: UNISON イントロ -->
		<section class="intro">
			<img
				class="intro__media"
				src="/images/unison-main.png"
				alt="雨上がりの街路で、しつけられた犬（コート着用）と男性が向き合う構図"
			/>
			<div class="intro__copy" data-reveal>
				<h1 class="intro__title">UNISON</h1>
				<p class="intro__subcopy">同じ素材、同じ機能、同じ表情。<br />境界線を越える、タクティカル・ドッグウェア。</p>
			</div>
		</section>

		<!-- Section 04: ビジュアルインターリュード -->
		<section class="interlude">
			<img class="interlude__media" src="/images/dog-forest-rain.png" alt="森の中を歩く犬（コート着用）。水たまりに反射" />
			<p class="interlude__copy" data-reveal>
				美しいシルエットと、異素材のコントラストが魅せる撥水加工コート。<br />闇夜に浮かぶ、一筋の光線。
			</p>
		</section>

		<!-- Section 05: 全天候型対応サイトハウンドアウター / プロダクト詳細（コート） -->
		<section class="section coat-product" id="coat">
			<SectionHeading title="全天候型対応サイトハウンドアウター" subtitle="All-Weather Sighthound Dog Shell" />

			<div class="product-detail__body">
				<div class="product-gallery" id="coat-gallery" data-reveal>
					<div class="carousel" id="coat-carousel">
						{
							coatPhotos.map((_, i) => (
								<div class="carousel__slide carousel__slide--square">
									<img src={`/images/coat-${pad2(i + 1)}.png`} alt={`コート商品写真 ${i + 1}/9`} loading="lazy" />
								</div>
							))
						}
					</div>
					<div class="carousel__dots" id="coat-dots">
						{
							coatPhotos.map((_, i) => (
								<button class="carousel__dot" data-index={i} aria-label={`${i + 1}枚目を表示`} type="button" />
							))
						}
					</div>
					<div class="thumb-grid thumb-grid--cols-3" id="coat-thumbs">
						{
							coatPhotos.map((_, i) => (
								<button class="thumb-grid__item" data-index={i} aria-label={`${i + 1}枚目に切り替え`} type="button">
									<img src={`/images/coat-${pad2(i + 1)}.png`} alt="" loading="lazy" />
								</button>
							))
						}
					</div>
				</div>

				<div class="coat-product__info" data-reveal>
					<p class="section__copy">
						定番の撥水加工素材コート。グレイハウンドの美しい曲線に沿った専用設計。高い襟元とシームシーリングが、雨水の侵入を抑え、快適なドライ環境をサポートします。丈夫な透湿防水レイヤー。R
						VEIL シグネチャー 立体ロゴ。
					</p>
					<dl class="spec-list">
						<div class="spec-list__row">
							<dt>fabric</dt>
							<dd>100% nylon</dd>
						</div>
						<div class="spec-list__row">
							<dt>color</dt>
							<dd>dark gray</dd>
						</div>
					</dl>
					<span class="swatch-bar swatch-bar--coat" aria-hidden="true"></span>
					<p class="price">28,800yen<span class="price__unit">（税込）</span></p>
					<button class="btn-circle purchase-btn" type="button">Purchase<br />予約 &gt;&gt;</button>
				</div>
			</div>
		</section>

		<!-- Section 06: 立体裁断 -->
		<section class="cutting">
			<SectionHeading title="立体裁断" level="h2" />
			<div class="cutting__media">
				<img src="/images/saidan.png" alt="ガラス越しに立つ犬（都市的背景）" />
				<p class="cutting__copy" data-reveal>
					犬の骨格と筋肉の動きを徹底的にサンプリングし、無駄のないタイト＆スマートなシルエットを実現しました。首周りから胸元、お腹にかけてのフィット感を高め、風や雨の侵入を軽減しながら、全力で走ってもズレにくいホッティング（カッティング）を追求。走る姿さえも美しい、アクティブかつエレガントな一着です。
				</p>
			</div>
		</section>

		<!-- Section 07: 撥水加工素材 -->
		<section class="section split">
			<SectionHeading title="撥水加工素材" level="h2" />
			<div class="split__grid">
				<div class="split__media" data-reveal>
					<img src="/images/hassui.png" alt="水滴のクローズアップ写真" />
				</div>
				<p class="split__copy" data-reveal>
					軽やかに纏う、撥水加工ウェア。上品さと撥水性を両立した上質なテキスタイルを採用。普段着としてデイリーに着回せるしなやかさでありながら、急な雨に見舞われても水分を玉のように弾きます。晴れの日から雨の日へ、シームレスに日常を繋ぐ一枚です。
				</p>
			</div>
		</section>

		<!-- Section 08: 夜行反射機能（テキスト左・写真右） -->
		<section class="section split split--reverse">
			<SectionHeading title="夜行反射機能" level="h2" />
			<div class="split__grid">
				<div class="split__media" data-reveal>
					<img src="/images/night.png" alt="反射ラインが光る犬の写真（暗所・車のライト演出）" />
				</div>
				<p class="split__copy" data-reveal>
					モダンな夜行反射ラインコートの美しいアウトライン（縁取り）に沿って、全方位にリフレクターラインを配置。暗い雨の日や夜間のお散歩でも、車のライトなどを浴びて美しく反射し、愛犬の視認性をスタイリッシュに高めます。
				</p>
			</div>
		</section>

		<!-- Section 09: 他のこだわり -->
		<section class="section material-detail">
			<SectionHeading title="他のこだわり" level="h2" />
			<div class="material-detail__icons" data-reveal>
				<div class="material-detail__icon">
					<img src="/images/particular-01.png" alt="立体ロゴ（型押し）" />
					<p class="material-detail__icon-caption">質感がある立体ロゴ</p>
				</div>
				<div class="material-detail__icon">
					<img src="/images/particular-02.png" alt="オリジナルキーホルダー" />
					<p class="material-detail__icon-caption">オリジナル キーホルダー</p>
				</div>
				<div class="material-detail__icon">
					<img src="/images/particular-03.png" alt="ファスナーテープ" />
					<p class="material-detail__icon-caption">ファスナーテープ</p>
				</div>
			</div>
		</section>

		<!-- Section 10: 職人の手元（裁断作業）バナー + 日本製・限定生産コピー -->
		<section class="craft">
			<div class="craft__media">
				<img src="/images/banner.png" alt="職人の手元（裁断作業）" />
			</div>
			<div class="craft__copy" data-reveal>
				<p class="craft__label">日本製 &nbsp;/&nbsp; 限定生産</p>
				<p class="craft__text">
					『R VEIL』は、限られた数だけを丁寧に仕立てるシリアル生産にこだわります。<br />
					愛犬との日々をより深く、よりスタイリッシュに彩る、<br />
					特別なマスターピースをその手に。
				</p>
			</div>
		</section>

		<!-- Section 11: Size Guide -->
		<section class="section size-guide">
			<p class="size-guide__title">Size Guide</p>
			<div class="split__grid split__grid--images">
				<div data-reveal><img src="/images/size-guide-01.png" alt="サイズ計測部位の図解（Back Length / Neck Girth / Chest Girth）" /></div>
				<div data-reveal><img src="/images/size-guide-02.png" alt="サイズ表（M/L/XL/XXL/3XL）" /></div>
			</div>
			<p class="note">
				※胸が深く細身の犬種（サイトハウンド等）は、胸周りのサイズを基準にお選びいただくことをおすすめします。<br />
				※他のサイズをお求めの方はお問い合わせください。
			</p>
		</section>

		<!-- Section 09: メンズウェア（フーディー）紹介 -->
		<section class="menswear">
			<div class="menswear__grid">
				<img src="/images/bag-bg01.png" alt="フーディー着用モデル（都市）" />
				<img src="/images/bag-bg02.png" alt="フーディー着用モデル（森）" />
				<div class="menswear__copy" data-reveal>
					両手を自由にする、革新のカラビナフック。<br />DOGウェアと美しく同調する、撥水加工リバーシブル・ハンズフリーバッグ。
				</div>
			</div>
		</section>

		<!-- Section 10: プロダクト詳細（エッセンシャル リバーシブルバッグ） -->
		<section class="section bag-product" id="bag">
			<SectionHeading title="エッセンシャル リバーシブルバッグ" subtitle="Essential Reversible Bag" />

			<div class="product-detail__body">
				<div class="product-gallery" id="bag-gallery" data-reveal>
					<div class="carousel" id="bag-carousel">
						{
							bagPhotos.map((_, i) => (
								<div class="carousel__slide carousel__slide--square">
									<img src={`/images/bag-${pad2(i + 1)}.png`} alt={`バッグ商品写真 ${i + 1}/10`} loading="lazy" />
								</div>
							))
						}
					</div>
					<div class="carousel__dots" id="bag-dots">
						{
							bagPhotos.map((_, i) => (
								<button class="carousel__dot" data-index={i} aria-label={`${i + 1}枚目を表示`} type="button" />
							))
						}
					</div>
					<div class="thumb-grid" id="bag-thumbs">
						{
							bagPhotos.map((_, i) => (
								<button class="thumb-grid__item" data-index={i} aria-label={`${i + 1}枚目に切り替え`} type="button">
									<img src={`/images/bag-${pad2(i + 1)}.png`} alt="" loading="lazy" />
								</button>
							))
						}
					</div>
					<p class="note">※実機と印刷物では、光の当たり方により色味が異なって見える場合がございます。</p>
				</div>

				<div class="bag-product__spec" data-reveal>
					<p class="section__copy">
						両手を自由にする、カラビナフック付き。DOGウェアと美しく同調する、撥水加工リバーシブル・ハンズフリーバッグ。表と裏でガラリと表情を変えられる贅沢なハイブリッド設計。撥水性機能と、夜道の視認性を高めるリフレクターロゴが、あなたと愛犬のアクティブな日常を上質なクオリティでサポートします。
					</p>
					<dl class="spec-list">
						<div class="spec-list__row">
							<dt>size</dt>
							<dd>H45cm / W43cm / D6cm</dd>
						</div>
						<div class="spec-list__row">
							<dt>fabric</dt>
							<dd>100% nylon</dd>
						</div>
					</dl>
					<p class="spec-list__label">color</p>
					<div class="swatch-row">
						<span class="swatch-row__label">face</span>
						<span class="swatch-bar swatch-bar--face" aria-hidden="true"></span>
					</div>
					<div class="swatch-row">
						<span class="swatch-row__label">back</span>
						<span class="swatch-bar swatch-bar--back" aria-hidden="true"></span>
					</div>
					<p class="price">18,800yen<span class="price__unit">（税込）</span></p>
					<button class="btn-circle purchase-btn" type="button">Purchase<br />予約 &gt;&gt;</button>
				</div>
			</div>
		</section>

		<!-- Section 11: 着用シーン（森） -->
		<section class="cutting">
			<div class="cutting__media">
				<img src="/images/bag-bg03.png" alt="森の中に立つ男性モデル全身写真" />
				<p class="cutting__copy" data-reveal>
					最大の特徴は、ショルダーストラップ（帯）に潜ませたバックルシステム。愛犬のリードをバッグに直接ジョイントすることで、お散歩中の「両手が自由になる」快適さを実現しました。
				</p>
			</div>
		</section>

		<!-- Section 12: 撥水加工素材（バッグ） -->
		<section class="section split">
			<SectionHeading title="撥水加工素材" level="h2" />
			<div class="split__grid split__grid--stacked-media">
				<div class="split__media split__media--stacked" data-reveal>
					<img src="/images/hassui-01.png" alt="撥水加工キルティング生地のクローズアップ" />
					<img src="/images/hassui-02.png" alt="撥水加工生地の質感クローズアップ" />
				</div>
				<p class="split__copy" data-reveal>
					愛犬のウェアと同じ撥水加工テキスタイルを採用。晴れの日も雨の日も、静かに寄り添う相棒に。上質な佇まいが、日常のスタイルにさりげなく溶け込みます。
				</p>
			</div>
		</section>

		<!-- Section 13: ショルダーストラップ仕様 -->
		<section class="cutting">
			<SectionHeading title="ショルダーストラップ仕様" level="h2" />
			<div class="cutting__media">
				<img src="/images/strap-bg.png" alt="バッグのカラビナフックとショルダーストラップのクローズアップ" />
				<p class="cutting__copy" data-reveal>
					両手を自由にする、カラビナフック。<br />DOGウェアと美しく同調する、撥水加工リバーシブル・ハンズフリーバッグ。
				</p>
			</div>
		</section>

		<!-- Section 14: リバーシブル訴求（両面ディテール） -->
		<section class="section reversible">
			<SectionHeading title="両面の表情を持つ" />
			<div class="reversible__layout">
				<div class="reversible__media reversible__media--1" data-reveal>
					<img src="/images/bag-bg04.png" alt="黒面のバッグ" />
				</div>
				<p class="reversible__text reversible__text--1" data-reveal>
					気分やスタイルに合わせて、ガラリと印象を変えられるリバーシブル仕様。シックな表情と、軽快なキルティング。
				</p>
				<div class="reversible__media reversible__media--2" data-reveal>
					<img src="/images/bag-bg05.png" alt="グレーキルティング面のバッグ" />
				</div>
				<p class="reversible__text reversible__text--2" data-reveal>
						どちらの面にも、夜間の視認性を高めるリフレクターロゴを配置しました。都市のディテールに溶け込む、デザインと機能性をこの一つに。
					</p>
				</div>
			</section>

			<!-- Section 15: detailed information -->
			<section class="section detailed-info">
				<p class="detailed-info__title">detailed information</p>
				<div class="detailed-info__grid">
					<div class="detailed-info__card" data-reveal>
						<div class="detailed-info__icon"><Placeholder label="information-01" ratio="1 / 1" rounded /></div>
						<p class="detailed-info__card-title">LIMITED MADE IN JAPAN</p>
						<p class="detailed-info__card-text">
							私たちのこだわりは、大量生産をしないこと。日本の熟練した職人が、一針一針にクラフトマンシップを注ぎ込み、限定数のみを丁寧に仕立てます。それは、大量消費の時代に向けた、丁寧なものづくりと贅沢の形です。
						</p>
					</div>
					<div class="detailed-info__card" data-reveal>
						<div class="detailed-info__icon"><Placeholder label="information-02" ratio="1 / 1" rounded /></div>
						<p class="detailed-info__card-title">ARCHITECTURAL CUTTING</p>
						<p class="detailed-info__card-text">
							愛犬の身体のラインを美しく魅せる、立体的なカッティングを追求。ミリ単位で計算されたパターンは、窮屈さを感じにくく、心地よいフィット感を生み出します。
						</p>
					</div>
					<div class="detailed-info__card" data-reveal>
						<div class="detailed-info__icon"><Placeholder label="information-03" ratio="1 / 1" rounded /></div>
						<p class="detailed-info__card-title">MONOCHROME LINK</p>
						<p class="detailed-info__card-text">
							愛犬のウェアと完全に同質・同素材で仕立てられた、オーナー様のためのバッグ&小物シリーズを展開します。愛犬と響き合う、シックで一体感のあるラグジュアリーな「リンクスタイル」を叶えます。
						</p>
					</div>
					<div class="detailed-info__card" data-reveal>
						<div class="detailed-info__icon"><Placeholder label="information-04" ratio="1 / 1" rounded /></div>
						<p class="detailed-info__card-title">HIGH-FUNCTION MINIMALISM</p>
						<p class="detailed-info__card-text">
							普段着としても美しい佇まいを演出する撥水素材を採用。落ち着いたトーンの生地は、シーンを問わず大人の気品を漂わせます。
						</p>
					</div>
				</div>
			</section>

			<!-- Section 16: concept -->
			<section class="section concept">
				<div class="concept__media" data-reveal>
					<img src="/images/concept.png" alt="コート・バッグの製品ディテールを並べたフラットレイ写真" />
					<p class="concept__label">concept</p>
				</div>
				<div class="concept__copy" data-reveal>
					<p>
						「R∴」には、“Ready（いつでも備える）”“Routine（日常に溶け込む）”“Rare（希少性）”といった想いを重ね、どんなシーンにも調和する一着を縫製。
					</p>
					<p>『R VEIL』は、都市の風景に静かに溶け込む、シックで洗練されたドッグウェアとオーナーズバッグを提案するクチュールブランドです。</p>
					<p>洗練されたベール（VEIL）で愛犬を包み込む優美なラインは量産品とは一線を画す、大人の品格を醸し出します。</p>
					<p>「静かに、美しく、雨を纏（まと）う。」<br />愛犬との時間は、何にも代えがたい特別なもの。<br />だからこそ、纏う衣服にも、妥協のない美学とクオリティを。</p>
					<p>過剰な装飾を削ぎ落としたミニマルなデザイン、雨を弾く撥水機能、そして犬の骨格を美しく魅せるカッティング。</p>
					<p>愛犬を子どもっぽく着飾るのではなく、一匹の「自立した美しいパートナー」として引き立てます。</p>
					<p>私たちが目指したのは、いかにも「レインコート」らしい無骨なデザインではなく、街に溶け込む上質なデイリーウェア。<br />日本の職人技が生み出す、機能性と美しさをお届けします。</p>
					<img class="concept__logo" src="/images/logo-small.png" alt="R VEIL ロゴマーク" />
				</div>
			</section>

			<!-- Section 17: memories -->
			<section class="section memories">
				<div class="memories__media" data-reveal>
					<img src="/images/memories.png" alt="愛犬のコートを手描きしたスケッチ" />
					<p class="memories__label">memories</p>
				</div>
				<div class="memories__copy" data-reveal>
					<p class="memories__heading">「動物と人間を、ひとつに繋ぐデザイン」</p>
					<p>
						ぼくのモノ作りの原点は、今も変わらず「手描き」です。<br />
						元ファッションデザイナーの経験を活かして、犬の服も、<br />
						人間が使うアイテムも、同じワクワクする気持ちでデザインしています。<br />
						目指しているのは、動物と人間がもっとひとつに繋がれる世界。<br />
						自由なペン先から生まれたアイデアを、<br />
						ぜひ楽しんでみてください！
					</p>
					<img class="memories__sign" src="/images/sign.png" alt="Steven のサイン、2026 summer" />
