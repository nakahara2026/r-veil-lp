<script>
	const heroVideo = document.querySelector('.hero__media');
	const heroPlay = document.getElementById('hero-play');
	const heroSeek = document.getElementById('hero-seek');
	const heroSeekFill = document.getElementById('hero-seek-fill');
	const heroTime = document.getElementById('hero-time');
	const heroMute = document.getElementById('hero-mute');
	const heroFullscreen = document.getElementById('hero-fullscreen');

	if (heroVideo instanceof HTMLVideoElement) {
		const formatTime = (seconds) => {
			if (!Number.isFinite(seconds)) return '00:00';
			const m = Math.floor(seconds / 60);
			const s = Math.floor(seconds % 60);
			return `${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`;
		};

		heroPlay?.addEventListener('click', () => {
			if (heroVideo.paused) {
				heroVideo.play();
			} else {
				heroVideo.pause();
			}
		});

		heroVideo.addEventListener('play', () => {
			if (heroPlay) heroPlay.textContent = '❚❚';
		});

		heroVideo.addEventListener('pause', () => {
			if (heroPlay) heroPlay.textContent = '▶';
		});

		heroVideo.addEventListener('timeupdate', () => {
			const pct = heroVideo.duration ? (heroVideo.currentTime / heroVideo.duration) * 100 : 0;
			if (heroSeekFill) heroSeekFill.style.width = `${pct}%`;
			if (heroTime) heroTime.textContent = `${formatTime(heroVideo.currentTime)} / ${formatTime(heroVideo.duration)}`;
		});

		heroSeek?.addEventListener('click', (event) => {
			const rect = heroSeek.getBoundingClientRect();
			const ratio = (event.clientX - rect.left) / rect.width;
			if (heroVideo.duration) {
				heroVideo.currentTime = ratio * heroVideo.duration;
			}
		});

		heroMute?.addEventListener('click', () => {
			heroVideo.muted = !heroVideo.muted;
			heroMute.textContent = heroVideo.muted ? '♪' : '🔊';
		});

		heroFullscreen?.addEventListener('click', () => {
			heroVideo.requestFullscreen?.();
		});
	}

	function initGallery(prefix) {
		const carousel = document.getElementById(`${prefix}-carousel`);
		const dotsContainer = document.getElementById(`${prefix}-dots`);
		const thumbsContainer = document.getElementById(`${prefix}-thumbs`);

		if (!carousel || !dotsContainer || !thumbsContainer) return;

		const slides = Array.from(carousel.querySelectorAll('.carousel__slide'));
		const dots = Array.from(dotsContainer.querySelectorAll('.carousel__dot'));
		const thumbs = Array.from(thumbsContainer.querySelectorAll('.thumb-grid__item'));

		let activeIndex = 0;

		const setActive = (index) => {
			activeIndex = index;
			dots.forEach((dot, i) => dot.classList.toggle('is-active', i === index));
			thumbs.forEach((thumb, i) => thumb.classList.toggle('is-active', i === index));
		};

		const goTo = (index) => {
			const slide = slides[index];
			if (slide) {
				carousel.scrollTo({ left: slide.offsetLeft, behavior: 'smooth' });
			}
		};

		const AUTOPLAY_INTERVAL = 4000;
		let autoplayTimer = 0;

		const startAutoplay = () => {
			autoplayTimer = window.setInterval(() => {
				goTo((activeIndex + 1) % slides.length);
			}, AUTOPLAY_INTERVAL);
		};

		const restartAutoplay = () => {
			window.clearInterval(autoplayTimer);
			startAutoplay();
		};

		dots.forEach((dot, i) =>
			dot.addEventListener('click', () => {
				goTo(i);
				restartAutoplay();
			}),
		);
		thumbs.forEach((thumb, i) =>
			thumb.addEventListener('click', () => {
				goTo(i);
				restartAutoplay();
			}),
		);

		const slideObserver = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) {
						setActive(slides.indexOf(entry.target));
					}
				});
			},
			{ root: carousel, threshold: 0.6 },
		);
		slides.forEach((slide) => slideObserver.observe(slide));

		setActive(0);
		startAutoplay();
	}

	initGallery('bag');
	initGallery('coat');
</script>
