<style>
	.section {
		padding: 64px 20px;
	}

	.section__copy {
		margin: 0 0 24px;
		color: var(--color-body);
	}

	/* Section 01: hero */
	/* モバイルは元動画が16:9の横長のため、そのままの比率だと被写体（人物・犬）の上下に
	   余白ができてしまう。4:5の縦長コンテナ+object-fit:coverで左右をトリミングし、
	   被写体を画面いっぱいに見せる。PCは100svhの全画面表示に戻す */
	.hero {
		position: relative;
		width: 100%;
		height: auto;
		aspect-ratio: 4 / 5;
		overflow: hidden;
	}

	/* 左右がトリミングされる分、被写体が画面中央からやや左寄りに収まるよう調整
	   （動画ループ全体で被写体の位置が変わるため、あくまで概算値。要目視調整） */
	.hero__media {
		width: 100%;
		height: 100%;
		display: block;
		object-fit: cover;
		object-position: 42% center;
	}

	.hero__controls {
		position: absolute;
		left: 20px;
		right: 20px;
		bottom: 24px;
		display: flex;
		align-items: center;
		gap: 10px;
		padding: 8px 12px;
		background: rgba(3, 3, 5, 0.55);
		border: 1px solid var(--color-divider);
		border-radius: 999px;
		backdrop-filter: blur(4px);
	}

	.hero__play,
	.hero__icon {
		flex: none;
		width: 24px;
		height: 24px;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		background: transparent;
		border: none;
		color: var(--color-heading);
		font-size: 11px;
	}

	.hero__seek {
		position: relative;
		flex: 1;
		height: 2px;
		background: var(--color-divider);
	}

	.hero__seek-fill {
		position: absolute;
		inset: 0;
		width: 5%;
		background: var(--color-heading);
	}

	.hero__time {
		flex: none;
		color: var(--color-caption);
		font-size: 10px;
		white-space: nowrap;
	}

	/* Section 02: news bar */
	.news-bar {
		background: var(--color-newsbar-bg);
		padding: 14px 20px;
	}

	.news-bar__text {
		margin: 0;
		color: var(--color-body);
		font-size: 11px;
		letter-spacing: 0.02em;
	}

	.news-bar__label {
		margin-right: 8px;
		color: var(--color-heading);
		font-weight: 700;
		letter-spacing: 0.1em;
	}

	.news-bar__link {
		margin-left: 6px;
		text-decoration: underline;
		text-underline-offset: 2px;
	}

	/* Section 03: intro */
	.intro {
		position: relative;
	}

	.intro__media {
		width: 100%;
		aspect-ratio: 3840 / 2000;
		object-fit: cover;
		filter: grayscale(5%) contrast(1.05) brightness(0.95);
	}

	.intro__copy {
		position: absolute;
		left: 20px;
		bottom: 28px;
		right: 20px;
	}

	.intro__title {
		margin: 0 0 12px;
		color: var(--color-heading);
		font-size: clamp(22px, 1.6vw + 1rem, 36px);
		font-weight: 300;
		letter-spacing: 0.15em;
	}

	.intro__subcopy {
		margin: 0;
		color: var(--color-body);
		font-size: 16px;
		line-height: 1.8;
		text-shadow: 0 1px 6px rgba(0, 0, 0, 0.6);
	}

	/* Section 06: 立体裁断
	   写真が横長（3840×2438）でモバイルでは高さが小さくなるため、モバイルはテキストを画像の下に配置し、
	   写真が縦に十分な高さを持つPC幅でのみ画像上へのオーバーレイに切り替える。 */
	.cutting {
		padding: 0 0 96px;
	}

	/* ショルダーストラップ仕様は直前が撥水加工素材（hassui-bg、標準の.sectionパディングのみ）で
	   他の.cutting（立体裁断・着用シーン）ほど余白が確保されないため、標準の.section上パディングを補う */
	.cutting--gap-top {
		padding-top: 64px;
	}

	/* 写真はフルブリードのままだが、見出しは他の.sectionと同じコンテンツ幅に収める */
	.cutting :global(.section-heading) {
		padding: 0 20px;
	}

	.cutting__media {
		position: relative;
	}

	/* vw基準の高さにすることで、フルブリード幅（cutting）とセクション内padding幅（split)が異なっても
	   立体裁断・撥水加工素材・リフレクターラインの3画像の高さがSPで揃う。
	   object-fit:containで被写体（犬の全身等）が見切れないようにする */
	.cutting__media img {
		width: 100%;
		height: 65vw;
		aspect-ratio: auto;
		object-fit: contain;
		filter: grayscale(5%) contrast(1.05) brightness(0.95);
	}

	.cutting__copy {
		margin: 24px 20px 0;
		color: var(--color-body);
	}

	/* Section 04: interlude */
	.interlude {
		position: relative;
	}

	.interlude__media {
		width: 100%;
		aspect-ratio: 3840 / 2640;
		object-fit: cover;
		filter: grayscale(5%) contrast(1.05) brightness(0.95);
	}

	/* 視認性を上げるため、テキストの背後に左上から右へ抜けるグラデーションパネルを敷く */
	.interlude__copy {
		position: absolute;
		top: 48px;
		left: 20px;
		max-width: 280px;
		margin: 0;
		padding: 16px 20px;
		border-radius: 15px;
		background: linear-gradient(to right, rgba(33, 33, 46, 0.5) 0%, rgba(36, 62, 57, 0) 100%);
		color: var(--color-body);
		text-shadow: 0 1px 6px rgba(0, 0, 0, 0.6);
	}

	/* 撥水加工素材（コート/バッグ共通）。PCでは.sectionのmax-width:1200pxに収まってしまうため、
	   Size Guideと同様にbox-shadowで背景色だけ画面幅いっぱいに広げる。
	   clip-pathで上下方向のシャドウの広がりを打ち消し、隣接セクションに色が漏れないようにする */
	.hassui-bg {
		background: #1b232a;
		box-shadow: 0 0 0 100vmax #1b232a;
		clip-path: inset(0 -100vmax);
	}

	/* split (text + image) blocks */
	.split__grid {
		display: flex;
		flex-direction: column;
		gap: 20px;
	}

	.split__grid--images {
		flex-direction: row;
	}

	.split__grid--images > div {
		flex: 1 1 0;
	}

	/* Size Guideの図解・表は写真ではないため、クロップやフィルターをかけず自然な比率で表示 */
	.split__grid--images img {
		width: 100%;
		display: block;
	}

	/* Size Guideのみモバイルは縦並び（両面ディテール等の他の画像+画像セクションには影響させない） */
	.size-guide .split__grid--images {
		flex-direction: column;
	}

	.split__media img {
		width: 100%;
		display: block;
		height: 120vw;
		aspect-ratio: auto;
		object-fit: contain;
		filter: grayscale(5%) contrast(1.05) brightness(0.95);
	}

	.split__copy {
		margin: 0 0 24px;
		color: var(--color-body);
	}

	/* 撥水加工素材（バッグ）：写真2枚を縦に積んで1つの画像カラムにする（余白なしで隣接） */
	.split__media--stacked {
		display: flex;
		flex-direction: column;
		gap: 0;
	}

	.split__media--stacked img {
		width: 100%;
		height: auto;
		aspect-ratio: auto;
		display: block;
		object-fit: cover;
		filter: grayscale(5%) contrast(1.05) brightness(0.95);
	}

	/* material detail */
	.material-detail__icons {
