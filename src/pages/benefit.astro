---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';

const benefitPhotos = Array.from({ length: 5 });
const pad2 = (n) => String(n).padStart(2, '0');
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout
	title="R VEIL — ご予約特典"
	description="ご予約いただいた先着20名様に、断熱マルチポーチをプレゼント。"
	showBackToTop={false}
>
	<main class="benefit-page">
		<section class="section benefit-heading-section">
			<div class="benefit-heading" data-reveal>
				<h2 class="benefit-heading__title">
					pre-order benefit<span class="benefit-heading__subtitle">ご予約特典</span>
				</h2>
				<span class="benefit-heading__rule"></span>
			</div>
		</section>

		<section class="section benefit-intro">
			<div class="benefit-intro__body">
				<p class="benefit-intro__title">ご予約いただいた先着20名様にマルチポーチをプレゼント</p>
				<p class="section__copy">
					ミニマルでエッジの効いたスクエアデザイン。ガジェットや小物を収納するマルチポーチとしてお使いいただけます。内側には保温・保冷シートを使用し、冷たいドリンクや温かい飲み物の持ち運びにも便利です。
				</p>
				<p class="note">
					※プレゼントは小物入れ本体のみです。サングラスは含まれません。<br />
					※掲載画像は試作品をもとにしたイメージです。実際の商品とは、色味・仕様・ロゴの配置などが異なる場合があります。
				</p>
			</div>
		</section>

		<div class="benefit-intro__visual">
			<img class="benefit-intro__photo" src={`${base}/images/benefit.png`} alt="ポーチとサングラスの写真" />
		</div>

		<section class="section benefit-product">
			<div class="product-detail__body">
				<div class="product-gallery" id="benefit-gallery" data-reveal>
					<div class="carousel" id="benefit-carousel">
						{
							benefitPhotos.map((_, i) => (
								<div class="carousel__slide carousel__slide--square">
									<img
										src={`${base}/images/benefit-${pad2(i + 1)}.png`}
										alt={`断熱マルチポーチ写真 ${i + 1}/5`}
										loading="lazy"
									/>
								</div>
							))
						}
					</div>
					<div class="carousel__dots" id="benefit-dots">
						{
							benefitPhotos.map((_, i) => (
								<button class="carousel__dot" data-index={i} aria-label={`${i + 1}枚目を表示`} type="button" />
							))
						}
					</div>
					<div class="thumb-grid" id="benefit-thumbs">
						{
							benefitPhotos.map((_, i) => (
								<button class="thumb-grid__item" data-index={i} aria-label={`${i + 1}枚目に切り替え`} type="button">
									<img src={`${base}/images/benefit-${pad2(i + 1)}.png`} alt="" loading="lazy" />
								</button>
							))
						}
					</div>
				</div>

				<div class="benefit-product__info" data-reveal>
					<SectionHeading title="断熱マルチポーチ" subtitle="Insulated Multi-Pouch" />
					<dl class="spec-list">
						<div class="spec-list__row">
							<dt>size</dt>
							<dd>H22cm / W11.5cm</dd>
						</div>
						<div class="spec-list__row">
							<dt>fabric</dt>
							<dd>100% nylon</dd>
						</div>
						<div class="spec-list__row">
							<dt>color</dt>
							<dd>dark gray</dd>
						</div>
					</dl>
					<span class="swatch-bar swatch-bar--benefit" aria-hidden="true"></span>
				</div>
			</div>
		</section>

		<section class="section benefit-close">
			<a href={`${base}/`} class="btn-circle benefit-close-btn">close</a>
		</section>
	</main>
</BaseLayout>

<style>
	/* コンテンツ幅（index.astroの.sectionと共通の考え方）: モバイルは左右20px、PCは1200px中央寄せ+40px */
	.section {
		padding: 64px 20px;
	}

	.benefit-page {
		padding-bottom: 40px;
	}

	/* Section B1: ヘッダー見出し「pre-order benefit / ご予約特典」 */
	.benefit-heading-section {
		padding-bottom: 60px;
	}

	.benefit-heading__title {
		margin: 0;
		display: flex;
		align-items: baseline;
		gap: 12px;
		color: var(--color-heading);
		font-size: clamp(22px, 2vw + 1rem, 28px);
		font-weight: 400;
		letter-spacing: 0.06em;
	}

	.benefit-heading__subtitle {
		color: var(--color-caption);
		font-size: 13px;
		font-weight: 400;
		letter-spacing: 0.04em;
	}

	.benefit-heading__rule {
		display: block;
		width: 100%;
		height: 1px;
		margin-top: 12px;
		background: var(--color-divider);
	}

	/* Section B2: 予約特典イントロ。
	   デザインカンプ実測：背景は画面いっぱいには伸びず、他の.sectionと同じコンテンツ幅の内側に収まる
	   （.hassui-bgのような全幅background技法は使わない）。
	   さらにbenefit.png実測により、背景自体も画面の真の端からは左右20pxだけ内側に収まっている
	   ことが判明したため、margin:0 20pxを追加する（PCは.sectionのmargin:0 auto側が
	   後勝ちするため元の中央寄せに戻る＝影響なし） */
	.benefit-intro {
		position: relative;
		background: #1b232a;
		margin: 0 20px;
		padding-top: 120px;
		/* 写真がここに重なるため、padding-bottomは写真の高さの約90%ぶん確保する（右側の計算式と対で
		   使うことで、写真の上端がちょうどnote文の直後＝padding-bottom開始位置に揃う） */
		padding-bottom: calc((100vw - 20px) * 0.5264);
	}

	.benefit-intro__body {
		position: relative;
		z-index: 2;
	}

	/* Section B2直下の写真。benefit.png実測の結果、2枚重ねスタックではなく
	   「左は無地の面、右にポーチ」という構図を最初から持つ1枚の横長写真であることが判明。
	   さらに実測の結果、写真は.benefit-introの背景に「重なって」配置されており、
	   写真の高さの約90%がパネルの下部に重なり、残り10%がパネルの下端からはみ出る
	   構成であることが判明（デザイナー意図として忠実に再現）。
	   .benefit-introセクションの外に出し（PC側でセクション自体のmax-width制約を受けず
	   画面の真の端まで伸ばすため）、左はコンテンツ幅の基準線に揃え、右は画面の真の端まで
	   伸ばす（design.md 3.3の見出し罫線伸長と同じ考え方をimgに応用）。
	   negative margin-topで.benefit-introの下部に重ねる（写真は後からDOM上に描画される
	   ため、position:absoluteを使わなくても自然にパネルより手前に表示される） */
	.benefit-intro__visual {
		margin: calc((100vw - 20px) * -0.5264) 0 0 20px;
	}

	.benefit-intro__photo {
		display: block;
		width: 100%;
		aspect-ratio: 1778 / 1040;
		object-fit: cover;
		filter: grayscale(5%) contrast(1.05) brightness(0.95);
	}

	.benefit-intro__title {
		margin: 0 0 20px;
		color: #797d83;
		font-weight: 400;
		line-height: 1.6;
	}

	.section__copy {
		margin: 0 0 24px;
		color: #fff;
	}

	.note {
		margin: 24px 0;
		color: #fff;
		font-size: 10px;
		line-height: 1.8;
	}

	/* Section B3/B4: 商品ギャラリー・スペック（coat/bag商品詳細と共通パターン） */
	.product-detail__body {
		display: flex;
		flex-direction: column;
		gap: 32px;
	}

	.carousel {
		display: flex;
		overflow-x: auto;
		scroll-snap-type: x mandatory;
		gap: 12px;
		margin-bottom: 12px;
		scrollbar-width: none;
	}

	.carousel::-webkit-scrollbar {
		display: none;
	}

	.carousel__slide {
		flex: 0 0 100%;
		scroll-snap-align: start;
	}

	.carousel__slide--square {
		aspect-ratio: 1 / 1;
		border-radius: 10px;
		overflow: hidden;
	}

	/* object-fit:coverのimgはGPU合成レイヤーに昇格し、親のoverflow:hidden+border-radiusによる
	   クリップが効かない場合がある（Safari/WebKit系の既知の挙動）。img自身にもborder-radiusを
	   明示することでクリップ漏れを防ぐ（top.md/design.md 4章参照） */
	.carousel__slide--square img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		border-radius: 10px;
	}

	.carousel__dots {
		display: flex;
		justify-content: center;
		gap: 8px;
		margin-bottom: 20px;
	}

	.carousel__dot {
		width: 6px;
		height: 6px;
		border-radius: 50%;
		border: none;
		background: var(--color-divider);
		padding: 0;
	}

	.carousel__dot.is-active {
		background: var(--color-heading);
	}

	.thumb-grid {
		display: grid;
		grid-template-columns: repeat(5, 1fr);
		gap: 8px;
	}

	.thumb-grid__item {
		background: none;
		border: 1px solid transparent;
		padding: 0;
		aspect-ratio: 1 / 1;
		border-radius: 10px;
		overflow: hidden;
	}

	.thumb-grid__item img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		border-radius: 10px;
	}

	.thumb-grid__item.is-active {
		border-color: var(--color-heading);
	}

	.spec-list {
		margin: 0 0 20px;
	}

	.spec-list__row {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 10px 0;
		border-bottom: 1px solid var(--color-divider);
	}

	.spec-list__row dt {
		color: var(--color-caption);
		font-size: 11px;
		letter-spacing: 0.08em;
		text-transform: lowercase;
	}

	.spec-list__row dd {
		margin: 0;
		color: var(--color-body);
		font-size: 13px;
	}

	/* デザインカンプ実測：coat/bagと同じ3トーン・グラデーションバー表現（単色ではない） */
	.swatch-bar {
		display: block;
		flex: 1 1 auto;
		max-width: 220px;
		height: 16px;
		border-radius: 2px;
		border: 1px solid var(--color-divider);
	}

	.swatch-bar--benefit {
		background: linear-gradient(to right, #443e3d 0% 68%, #5c5a57 68% 85%, #bab6a0 85% 100%);
	}

	/* Section B5: close CTA。Purchase/Back to Topと同じ.btn-circle基盤＋専用配色 */
	.benefit-close {
		display: flex;
	}

	.benefit-close-btn {
		width: 120px;
		height: 120px;
		background: rgba(76, 55, 100, 0.7);
		text-decoration: none;
	}

	@media (min-width: 768px) {
		.section {
			max-width: 1200px;
			margin: 0 auto;
			padding: 96px 40px;
		}

		/* PCも同じ考え方：padding-bottomは写真高さの約90%を確保（padding-topはSPと同じ120pxのまま） */
		.benefit-intro {
			padding-bottom: calc((100vw - max(40px, (100vw - 1200px) / 2 + 40px)) * 0.5264);
		}

		.benefit-heading-section {
			padding-bottom: 60px;
		}

		/* デザインカンプ実測パターン踏襲：右端だけ画面の真の端まで伸ばす（.cutting/.split--reverseと同じ考え方） */
		.benefit-heading__rule {
			width: calc(100% + max(40px, (100vw - 1200px) / 2 + 40px));
		}

		/* PCではコンテンツ幅の基準線に左を揃え、右だけ画面の真の端まで伸ばす
		   （design.md 3.3の見出し罫線伸長と同じ計算式をimgに応用）。
		   negative margin-topで.benefit-introの下部（padding-bottom分の高さ90%）に重ねる */
		.benefit-intro__visual {
			--benefit-intro-visual-left: max(40px, calc((100vw - 1200px) / 2 + 40px));
			margin: calc((100vw - var(--benefit-intro-visual-left)) * -0.5264) 0 0 var(--benefit-intro-visual-left);
			width: calc(100vw - var(--benefit-intro-visual-left));
		}

		.product-detail__body {
			flex-direction: row-reverse;
			align-items: flex-start;
			gap: 64px;
		}

		.product-gallery {
			flex: 0 1 auto;
			width: min(60vh, 500px);
		}

		.benefit-product__info {
			flex: 1 1 0;
		}

		#benefit-carousel {
			width: 100%;
			height: auto;
			aspect-ratio: 1 / 1;
			margin: 0 auto 12px;
		}

		#benefit-carousel .carousel__slide {
			height: 100%;
		}

		.product-gallery .thumb-grid,
		.product-gallery .carousel__dots {
			width: 100%;
		}
	}
</style>

<script>
	function initGallery(prefix) {
		const carousel = document.getElementById(`${prefix}-carousel`);
		const dotsContainer = document.getElementById(`${prefix}-dots`);
		const thumbsContainer = document.getElementById(`${prefix}-thumbs`);

		if (!carousel || !dotsContainer || !thumbsContainer) return;

		const slides = Array.from(carousel.querySelectorAll('.carousel__slide'));
		const dots = Array.from(dotsContainer.querySelectorAll('.carousel__dot'));
		const thumbs = Array.from(thumbsContainer.querySelectorAll('.thumb-grid__item'));

		let activeIndex = 0;

		const setActive = (index) => {
			activeIndex = index;
			dots.forEach((dot, i) => dot.classList.toggle('is-active', i === index));
			thumbs.forEach((thumb, i) => thumb.classList.toggle('is-active', i === index));
		};

		const goTo = (index) => {
			const slide = slides[index];
			if (slide) {
				carousel.scrollTo({ left: slide.offsetLeft, behavior: 'smooth' });
			}
		};

		const AUTOPLAY_INTERVAL = 4000;
		let autoplayTimer = 0;

		const startAutoplay = () => {
			autoplayTimer = window.setInterval(() => {
				goTo((activeIndex + 1) % slides.length);
			}, AUTOPLAY_INTERVAL);
		};

		const restartAutoplay = () => {
			window.clearInterval(autoplayTimer);
			startAutoplay();
		};

		dots.forEach((dot, i) =>
			dot.addEventListener('click', () => {
				goTo(i);
				restartAutoplay();
			}),
		);
		thumbs.forEach((thumb, i) =>
			thumb.addEventListener('click', () => {
				goTo(i);
				restartAutoplay();
			}),
		);

		const slideObserver = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) {
						setActive(slides.indexOf(entry.target));
					}
				});
			},
			{ root: carousel, threshold: 0.6 },
		);
		slides.forEach((slide) => slideObserver.observe(slide));

		setActive(0);
		startAutoplay();
	}

	initGallery('benefit');
</script>
