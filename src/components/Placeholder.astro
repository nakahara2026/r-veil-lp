---
const { label = 'IMAGE', ratio = '4 / 5', rounded = false } = Astro.props;
---

<div class="placeholder" class:list={{ 'placeholder--rounded': rounded }} style={`aspect-ratio: ${ratio};`}>
	<span class="placeholder__label">{label}</span>
</div>

<style>
	.placeholder {
		width: 100%;
		display: flex;
		align-items: center;
		justify-content: center;
		background: repeating-linear-gradient(135deg, #1a1a1c 0 10px, #202022 10px 20px);
		border: 1px solid var(--color-divider);
		color: var(--color-caption);
		font-size: 11px;
		letter-spacing: 0.04em;
		text-align: center;
		padding: 12px;
	}

	.placeholder--rounded {
		border-radius: 50%;
	}
</style>
