---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<header class="site-header">
	<h1 class="site-header__logo">
		<a href={`${base}/`}>
			<img src={`${base}/images/logo.png`} alt="R VEIL" />
		</a>
	</h1>
</header>

<style>
	.site-header {
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		z-index: 50;
		padding: 20px;
	}

	.site-header__logo {
		margin: 0;
	}

	.site-header__logo a {
		display: inline-block;
	}

	/* logo.pngは黒一色のアセットのため、ダーク背景でも見えるよう白反転させる
	   （design.mdのロゴ配色トークンはPure White #FFFFFFのため、これが正しい見え方） */
	.site-header__logo img {
		display: block;
		height: 40px;
		width: auto;
		filter: invert(1);
	}

	@media (min-width: 768px) {
		.site-header__logo img {
			height: 65px;
		}
	}
</style>
